# Copy to .env.local and fill in. Never commit .env.local.
#
# Frontend (public — shipped to the browser)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Local development against `npm run db:start` instead:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<printed by `supabase start`>

# Edge function secrets are NOT read from this file. Set them on the
# project with `npx supabase secrets set KEY=value`:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET   (payments)
#   RESEND_API_KEY, NOTIFICATIONS_FROM_EMAIL   (email)
#   APP_URL                                    (links in emails / Stripe redirects)
